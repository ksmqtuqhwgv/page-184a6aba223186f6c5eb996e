          "body": "<style>\n  :root{--ink:#141414;--ink-2:#3a3a3a;--gray:#6e6e6e;--line:#d6d6d6;--paper:#f4f3f1;--white:#ffffff;--accent:#ff4d2e}\n  *{box-sizing:border-box}\n  html{}\n  body{margin:0;background:var(--paper);color:var(--ink);font-family:\"Helvetica Neue\",Arial,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased}\n  a{color:inherit}\n  .shell{display:flex;align-items:flex-start;max-width:1360px;margin:0 auto}\n  /* 左侧竖排目录 */\n  .rail{position:sticky;top:0;flex:0 0 186px;width:186px;min-height:100vh;padding:34px 20px 34px 24px;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:28px}\n  .rail-mark{font-weight:800;letter-spacing:-0.02em;font-size:18px;line-height:1.2}\n  .rail-mark span{display:block;font-size:10px;letter-spacing:0.28em;font-weight:500;color:var(--gray);margin-top:6px;text-transform:uppercase}\n  .rail nav ol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:2px}\n  .rail nav a{display:block;padding:5px 0 5px 12px;font-size:13px;color:var(--gray);text-decoration:none;border-left:1px solid var(--line);letter-spacing:0.02em;transition:color .18s,border-color .18s}\n  .rail nav a:hover,\n  .rail nav a:focus{color:var(--ink);border-left-color:var(--accent)}\n  .rail-note{margin-top:auto;font-size:11px;color:var(--gray);line-height:1.6;border-top:1px solid var(--line);padding-top:14px}\n  .content{flex:1 1 auto;min-width:0;padding:0 44px 0 52px}\n\n  /* 首屏：超大品牌名海报式 */\n  .poster{padding:56px 0 26px;border-bottom:1px solid var(--ink)}\n  .poster-eyebrow{display:flex;flex-wrap:wrap;gap:14px;align-items:center;font-size:11px;letter-spacing:0.24em;color:var(--gray);text-transform:uppercase;margin-bottom:20px}\n  .poster-eyebrow b{color:var(--accent);font-weight:700;letter-spacing:0.24em}\n  h1{margin:0;font-size:clamp(64px,15vw,190px);line-height:0.86;letter-spacing:-0.055em;font-weight:800}\n  h1 em{font-style:normal