-height:1;margin:14px 0 4px}\n  .plan-price small{font-size:13px;font-weight:500;letter-spacing:0;color:var(--gray);margin-left:4px}\n  .plan.is-featured .plan-price small{color:#b9b9b9}\n  .plan-year{font-size:12px;color:var(--gray);margin:0 0 18px}\n  .plan.is-featured .plan-year{color:#b9b9b9}\n  .plan ul{list-style:none;margin:0 0 22px;padding:0;font-size:14px}\n  .plan ul li{padding:9px 0;border-top:1px solid var(--line);display:flex;gap:10px}\n  .plan.is-featured ul li{border-top-color:#3d3d3d}\n  .plan ul li::before{content:\"—\";color:var(--accent);font-weight:700;flex:0 0 auto}\n  .plan-cta{margin-top:auto;display:block;text-align:center;text-decoration:none;border:2px solid var(--ink);padding:11px 16px;font-size:14px;font-weight:700;letter-spacing:0.04em;background:transparent;color:var(--ink)}\n  .plan.is-featured .plan-cta{background:var(--white);border-color:var(--white);color:var(--ink)}\n  .plan-cta:hover{background:var(--accent);border-color:var(--accent);color:var(--white)}\n  .plan-note{margin:22px 0 0;font-size:13px;color:var(--gray)}\n\n  /* 团队版单独逐行展开 */\n  .team{margin-top:20px;display:grid;grid-template-columns:minmax(180px,1fr) minmax(220px,2fr);gap:0;border:2px solid var(--ink);background:var(--white)}\n  .team-head{padding:24px;border-right:2px solid var(--ink)}\n  .team-head h3{margin:0 0 6px;font-size:19px}\n  .team-head .plan-price{margin:10px 0 2px;font-size:34px}\n  .team-body{padding:8px 24px 16px}\n  .team-body dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:0 16px}\n  .team-body dt{font-size:13px;color:var(--gray);padding:10px 0;border-top:1px solid var(--line)}\n  .team-body dd{margin:0;font-size:14px;padding:10px 0;border-top:1px solid var(--line)}\n  .team-body dt:first-of-type,\n  .team-body dd:first-of-type{border-top:none}\n\n  /* 客户端区块 */\n  .client-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}\n  .client{border:2px solid var(--ink);background:var(--white);padding:22px;display:flex;flex-direction:column;gap:10px}\n  .client h3{margin:0;font-size:16px}\n  .client p{margin:0;font-size:14px;color:var(--ink-2)}\n  .client .client-state{margin-top:auto;font-size:12px;letter-spacing:0.08em;color:var(--gray);border-top:1px dashed var(--line);padding-top:10px}\n  .client .client-state a{color:var(--accent);font-weight:700;text-decoration:none}\n\n  /* FAQ 对话气泡 */\n  .chat{display:flex;flex-direction:column;gap:18px;max-width:820px}\n  .qa{display:flex;flex-direction:column;gap:10px}\n  .q{align-self:flex-start;background:var(--ink);color:var(--white);padding:12px 18px;font-size:15px;font-weight:700;max-width:100%;border:2px solid var(--ink)}\n  .a{align-self:flex-end;background:var(--white);border:2px solid var(--ink);padding:14px 18px;font-size:14px;color:var(--ink-2);max-width:92%}\n  .a strong{color:var(--ink)}\n  .faq-extra{margin-top:26px;font-size:13px;color:var(--gray);max-width:820px}\n  .faq-extra a{color:var(--ink);font-weight:700;text-decoration:underline;text-underline-offset:3px}\n\n  /* 页脚 */\n  .foot{padding:40px 0 64px;display:flex;flex-wrap:wrap;gap:18px 40px;justify-content:space-between;align-items:flex-end;font-size:13px;color:var(--gray)}\n  .foot b{display:block;color:var(--ink);font-size:15px;letter-spacing:-0.01em;margin-bottom:4px}\n  .foot .foot-links{display:flex;gap:18px;flex-wrap:wrap}\n  .foot .foot-links a{text-decoration:none;border-bottom:1px solid var(--line)}\n  .foot .foot-links a:hover{border-bottom-color:var(--accent)}\n\n  @media (max-width:900px){\n    .shell{display:block}\n    .rail{position:static;width:auto;min-height:0;border-right:none;border-bottom:1px solid var(--ink);padding:20px 20px 18px;flex-direction:row;flex-wrap:wrap;align-items:center;gap:16px}\n    .rail-mark{font-size:16px}\n    .rail-mark span{display:none}\n    .rail nav{flex:1 1 auto}\n    .rail nav ol{flex-direction:row;flex-wrap:wrap;gap:6px 14px}\n    .rail nav a{border-left:none;border-bottom:1px solid var(--line);padding:2px 0}\n    .rail-note{display:none}\n    .content{padding:0 20px}\n    .poster{padding:34px 0 20px}\n    .team{grid-template-columns:1fr}\n    .team-head{border-right:none;border-bottom:2px solid var(--ink)}\n    section{padding:40px 0}\n    .poster-foot{gap:20px}\n    .plan-price{font-size:34px}\n    .a{max-width:100%}\n  }\n</style><div class=\"shell\">\n  <aside class=\"rail\">\n    <div class=\"rail-mark\">速度云<span>SUDU CLOUD</span></div>\n    <nav aria-label=\"页面目录\">\n      <ol>\n        <li><a href=\"#start\">怎么开始</a></li>\n        <li><a href=\"#plans\">套餐与价格</a></li>\n        <li><a href=\"#clients\">客户端</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ol>\n    </nav>\n    <div class=\"rail-note\">\n      页面上的价格、流量与设备数都写全了。<br>看不懂的地方，直接问。\n    </div>\n  </aside>\n\n  <div class=\"content\">\n    <main>\n      <div class=\"poster\">\n        <div class=\"poster-eyebrow\">\n          <b>订阅品牌</b>\n          <span>三档方案</span>\n          <span>价格公开</span>\n        </div>\n        <h1>速度<em>云</em></h1>\n        <div class=\"poster-foot\">\n          <p class=\"poster-lead\">你好，这里是速度云。我们不太会写那种“立刻起飞”的广告词，只把套餐里的流量、设备数量和价格摆在一起，让你自己挑一档合适的。</p>\n          <div class=\"poster-tags\">\n            <span class=\"tag\">月付 / 年付</span>\n            <span class=\"tag\">设备数写明</span>\n            <span class=\"tag\">可升级</span>\n          </div>\n        </div>\n      </div>\n\n      <section id=\"start\">\n        <div class=\"sec-head\">\n          <span class=\"sec-num\">01</span>\n          <h2>先弄清楚三件事，再决定买哪档</h2>\n          <p class=\"sec-sub\">不用一口气读完，按顺序看就行。</p>\n        </div>\n        <div class=\"how-grid\">\n          <div class=\"box\">\n            <span class=\"num\">STEP 01</span>\n            <h3>数一数你手上几台设备</h3>\n            <p>手机、平板、电脑都算一台。基础版 3 台，旗舰版 5 台，团队版 20 台。同时在线才算，放着不用不占名额。</p>\n          </div>\n          <div class=\"box\">\n            <span class=\"num\">STEP 02</span>\n            <h3>估一下每月大概用多少</h3>\n            <p>刷视频比看文字费流量。拿不准就往上取一档，后面升级比退订省事，也不用重配一遍。</p>\n          </div>\n          <div class=\"box\">\n            <span class=\"num\">STEP 03</span>\n            <h3>再选月付还是年付</h3>\n            <p>年付就是十个多月的价格买整年。不确定能不能长期用，先月付一个月试试手感，我们不会给你打续费电话。</p>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"plans\">\n        <div class=\"sec-head\">\n          <span class=\"sec-num\">02</span>\n          <h2>基础版和旗舰版摆一起，你自己对照</h2>\n          <p class=\"sec-sub\">两档最常被拿来比较的方案，左边便宜，右边更宽裕。</p>\n        </div>\n\n        <div class=\"plan-pair\">\n          <article class=\"plan\">\n            <h3>基础版</h3>\n            <p class=\"plan-price\">¥15<small>/月</small></p>\n            <p class=\"plan-year\">按年付 ¥150 / 年</p>\n            <ul>\n              <li>每月 100GB 流量</li>\n              <li>3 台设备同时在线</li>\n              <li>基础流媒体解锁</li>\n              <li>普通线路节点池</li>\n            </ul>\n            <a class=\"plan-cta\" href=\"#\">选基础版</a>\n          </article>\n\n          <article class=\"plan is-featured\">\n            <span class=\"plan-flag\">多数人的选择</span>\n            <h3>旗舰版</h3>\n            <p class=\"plan-price\">¥35<small>/月</small></p>\n            <p class=\"plan-year\">按年付 ¥350 / 年</p>\n            <ul>\n              <li>每月 300GB 流量</li>\n              <li>5 台设备同时在线</li>\n              <li>全节点原生流媒体解锁</li>\n              <li>IPLC 专线游戏加速优化</li>\n              <li>7x24 优先工单支持</li>\n            </ul>\n            <a class=\"plan-cta\" href=\"#\">选旗舰版</a>\n          </article>\n        </div>\n\n        <div class=\"team\">\n          <div class=\"team-head\">\n            <h3>团队版</h3>\n            <p class=\"plan-price\">¥85<small>/月</small></p>\n            <p class=\"plan-year\">按年付 ¥850 / 年</p>\n          </div>\n          <div class=\"team-body\">\n            <dl>\n              <dt>每月流量</dt>\n              <dd>1000GB</dd>\n              <dt>同时在线设备</dt>\n              <dd>20 台</dd>\n              <dt>节点</dt>\n              <dd>VIP 专属高带宽节点</dd>\n              <dt>路由</dt>\n              <dd>支持企业定制路由</dd>\n              <dt>服务</dt>\n              <dd>专属客户经理对接</dd>\n            </dl>\n          </div>\n        </div>\n\n        <p class=\"plan-note\">页面上的价格就是结算价格。年付价格按整年一次性支付，中途升级按剩余时长折算，具体以开通页展示为准。</p>\n      </section>\n\n      <section id=\"clients\">\n        <div class=\"sec-head\">\n          <span class=\"sec-num\">03</span>\n          <h2>客户端：先看你的设备，再看要不要装</h2>\n          <p class=\"sec-sub\">我们不硬推下载，先把适用的设备说清楚。</p>\n        </div>\n        <div class=\"client-row\">\n          <article class=\"client\">\n            <h3>桌面端</h3>\n            <p>在电脑上使用，适合工作时段长期挂着。登录后按套餐设备名额占用一台。</p>\n            <p class=\"client-state\"><a href=\"#\">下载入口</a> · 版本与系统要求以入口页说明为准</p>\n          </article>\n          <article class=\"client\">\n            <h3>移动端</h3>\n            <p>手机上使用，通勤和外出时更顺手。与桌面端共用同一份设备名额。</p>\n            <p class=\"client-state\"><a href=\"#\">下载入口</a> · 上架情况以入口页说明为准</p>\n          </article>\n          <article class=\"client\">\n            <h3>网页端</h3>\n            <p>临时用一下别人的电脑，可以不装东西。能不能用、占不占名额，以开通页说明为准。</p>\n            <p class=\"client-state\"><a href=\"#\">进入网页端</a> · 无需额外安装</p>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"faq\">\n        <div class=\"sec-head\">\n          <span class=\"sec-num\">04</span>\n          <h2>常见问题，像聊天一样讲</h2>\n          <p class=\"sec-sub\">下面是问得最多的几个，答得直白一点。</p>\n        </div>\n\n        <div class=\"chat\">\n          <div class=\"qa\">\n            <div class=\"q\">我只有一台电脑一部手机，基础版够吗？</div>\n            <div class=\"a\"><strong>够用。</strong>基础版支持 3 台设备同时在线，正好留一个余量给平板。流量 100GB 一个月，看文字、开网页、偶尔看剧都没问题；如果天天刷高清视频，直接看旗舰版更省心。</div>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">年付中途不想用了，剩下的钱怎么办？</div>\n            <div class=\"a\">年付是一次性支付整年费用，中途停止使用不退回剩余部分。所以我们一般建议：<strong>先月付一个月</strong>，确认自己用得上，再转年付。这比反过来要稳妥。</div>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">三档之间可以随时换吗？</div>\n            <div class=\"a\">可以。往上升级时，按你剩余时长折算差价，多出来的部分补上就行。往下降档位，在下一个计费周期生效。具体折算数字以开通页为准，我不在这里随口报。</div>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">旗舰版的 IPLC 专线，对打游戏真有帮助吗？</div>\n            <div class=\"a\">这是旗舰版的一项目标优化，主要针对游戏场景的线路走向。实际体验受你所在地区、运营商和游戏服务器影响，<strong>我们不承诺具体延迟数字</strong>，也不承诺一定能改善。介意的话，先月付试试。</div>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">团队版要几个人起用？</div>\n            <div class=\"a\">没有人数下限，按 20 台设备同时在线来算就行。团队版多出来的是 VIP 高带宽节点、企业定制路由和专属客户经理。如果只是两三个人用，旗舰版通常更划算。</div>\n          </div>\n          <div class=\"qa\">\n            <div class=\"q\">遇到问题找谁？</div>\n            <div class=\"a\">走工单。旗舰版是优先工单、7x24 响应，团队版由专属客户经理对接。基础版也能提工单，只是排在后面。<strong>响应时间是排队顺序的承诺，不是修复时间。</strong></div>\n          </div>\n        </div>\n\n        <p class=\"faq-extra\">没找到你的问题？在工单里写清楚设备和具体现象，比一句“用不了”有用得多，我们回起来也快。<a href=\"#\">去提工单</a></p>\n      </section>\n    </main>\n\n    <footer class=\"foot\">\n      <div>\n        <b>速度云</b>\n        三档方案，价格与流量都写在页面上。\n      </div>\n      <div class=\"foot-links\">\n        <a href=\"#start\">怎么开始</a>\n        <a href=\"#plans\">套餐与价格</a>\n        <a href=\"#clients\">客户端</a>\n        <a href=\"#faq\">常见问题</a>\n      </div>\n    </footer>\n  </div>\n</div>",
